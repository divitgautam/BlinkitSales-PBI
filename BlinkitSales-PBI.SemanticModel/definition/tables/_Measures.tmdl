/// Central home for report measures (no data).
table _Measures
	lineageTag: 5d0f3162-434d-427e-aa54-96953a4db60e

	/// Revenue = sum of order totals (order header), in assumed INR. The revenue measure for every card and title.
	measure Revenue = SUM ( fact_orders[Order Total] )
		formatString: ₹#,##0
		displayFolder: 1 Sales
		lineageTag: ab731d2d-7f2c-4fc8-8901-497e0c832011

	/// Number of orders (one row per order).
	measure Orders = COUNTROWS ( fact_orders )
		formatString: #,##0
		displayFolder: 1 Sales
		lineageTag: 413acdaf-ef5a-4836-9cf4-e8d9117e4ddb

	/// Average order value = Revenue / Orders.
	measure AOV = DIVIDE ( [Revenue], [Orders] )
		formatString: ₹#,##0.00
		displayFolder: 1 Sales
		lineageTag: a9099cae-1217-4f17-87df-bd493d4111d1

	/// Distinct customers with at least one order in the selection (the customer file has 2,500, of whom 2,172 order).
	measure 'Customers Ordering' = DISTINCTCOUNT ( fact_orders[Customer Id] )
		formatString: #,##0
		displayFolder: 1 Sales
		lineageTag: 4c44b2c0-82b5-4056-9a10-cb3b63b01f54

	/// Customers with two or more orders in the selection.
	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( fact_orders[Customer Id] ), CALCULATE ( COUNTROWS ( fact_orders ) ) >= 2 ) )
		formatString: #,##0
		displayFolder: 1 Sales
		lineageTag: 423e3385-7d84-442e-b1b6-e11587d52ffe

	/// Repeat customers / customers ordering.
	measure 'Repeat Rate' = DIVIDE ( [Repeat Customers], [Customers Ordering] )
		formatString: 0.0%
		displayFolder: 1 Sales
		lineageTag: c3e5b446-46e7-4dda-a812-eccacc92c591

	/// Units on the order item lines.
	measure 'Units Sold' = SUM ( fact_orders[Quantity] )
		formatString: #,##0
		displayFolder: 1 Sales
		lineageTag: 23784079-c8b6-4ca4-ae1c-0c39b1664a47

	/// Revenue / customers ordering.
	measure 'Revenue per Customer' = DIVIDE ( [Revenue], [Customers Ordering] )
		formatString: ₹#,##0.00
		displayFolder: 1 Sales
		lineageTag: adda2c2a-8c8f-40a0-9db6-ab139218dc1a

	/// Quantity x unit price on the item lines, in assumed INR. Use ONLY for category and product mix: it does not reconcile to Revenue (about 45% of it in the source).
	measure 'Line Value' = SUM ( fact_orders[Line Amount] )
		formatString: ₹#,##0
		displayFolder: 1 Sales
		lineageTag: 9b15e742-4984-40f5-9cdd-ea20b3e1632b

	/// Category share of line value within the current selection (use with Category on an axis).
	measure 'Category Share' = DIVIDE ( [Line Value], CALCULATE ( [Line Value], ALLSELECTED ( dim_product[Category] ) ) )
		formatString: 0.0%
		displayFolder: 1 Sales
		lineageTag: 0440b1f1-8cd0-497e-bc19-bef1317f87e9

	/// Dense rank of a category by line value within the selection.
	measure 'Category Rank' = IF ( NOT ISBLANK ( [Line Value] ), RANKX ( ALLSELECTED ( dim_product[Category] ), [Line Value], , DESC, DENSE ) )
		formatString: 0
		displayFolder: 1 Sales
		lineageTag: 0698a6d4-1a11-4091-8070-101e97fa80b0

	/// Average stored margin of the products in the selection (simple average across products).
	measure 'Avg Margin %' = DIVIDE ( AVERAGE ( dim_product[Margin Percentage] ), 100 )
		formatString: 0.0%
		displayFolder: 1 Sales
		lineageTag: 3c562242-4a26-4cb0-bdb6-734e23ee761d

	/// Orders delivered On Time (includes up to 5 minutes late).
	measure 'On-Time Orders' = CALCULATE ( [Orders], fact_orders[Delivery Status] = "On Time" )
		formatString: #,##0
		displayFolder: 2 Delivery
		lineageTag: 03e82b7f-cc09-470f-a825-72401465ea54

	/// On-time orders / orders. Late % = 1 - On-Time %.
	measure 'On-Time %' = DIVIDE ( [On-Time Orders], [Orders] )
		formatString: 0.0%
		displayFolder: 2 Delivery
		lineageTag: b38f1a5b-33af-4fbf-8138-c110d1c8b612

	/// Orders not delivered On Time (Slightly or Significantly Delayed).
	measure 'Late Orders' = CALCULATE ( [Orders], fact_orders[Is Late] = TRUE () )
		formatString: #,##0
		displayFolder: 2 Delivery
		lineageTag: 31703c64-b4db-4277-a8cb-96bc41e7d168

	/// Late orders / orders.
	measure 'Late %' = DIVIDE ( [Late Orders], [Orders] )
		formatString: 0.0%
		displayFolder: 2 Delivery
		lineageTag: 8f2f4a56-8bdc-4791-9420-d1f0ec3f7e96

	/// Share of orders with status Slightly Delayed.
	measure 'Slightly Delayed %' = DIVIDE ( CALCULATE ( [Orders], fact_orders[Delivery Status] = "Slightly Delayed" ), [Orders] )
		formatString: 0.0%
		displayFolder: 2 Delivery
		lineageTag: 88f91f12-1d19-4e42-b0ea-560a6760f78b

	/// Share of orders with status Significantly Delayed.
	measure 'Significantly Delayed %' = DIVIDE ( CALCULATE ( [Orders], fact_orders[Delivery Status] = "Significantly Delayed" ), [Orders] )
		formatString: 0.0%
		displayFolder: 2 Delivery
		lineageTag: deb001e2-0466-445b-9105-f188c2be81e0

	/// Mean of minutes late; early deliveries count as negative minutes.
	measure 'Avg Minutes Late' = AVERAGE ( fact_orders[Minutes Late] )
		formatString: 0.00
		displayFolder: 2 Delivery
		lineageTag: 28c456da-a488-445b-b634-ca7e70904214

	/// Mean minutes late among late orders only.
	measure 'Avg Minutes Late (Late Orders)' = CALCULATE ( AVERAGE ( fact_orders[Minutes Late] ), fact_orders[Is Late] = TRUE () )
		formatString: 0.00
		displayFolder: 2 Delivery
		lineageTag: c29a10ef-cb9d-4ec5-baf4-2f167848ffa7

	/// Mean delivery distance in kilometres.
	measure 'Avg Distance Km' = AVERAGE ( fact_orders[Distance Km] )
		formatString: 0.00
		displayFolder: 2 Delivery
		lineageTag: cb64214c-622c-475d-8d26-cf1137fb62ad

	/// Mean customer rating, 1-5 stars.
	measure 'Avg Rating' = AVERAGE ( fact_orders[Rating] )
		formatString: 0.00
		displayFolder: 3 Experience
		lineageTag: 07b16f4d-53f9-4b14-b580-3b758b938282

	/// Mean rating of on-time orders.
	measure 'Avg Rating On-Time' = CALCULATE ( [Avg Rating], fact_orders[Delivery Status] = "On Time" )
		formatString: 0.00
		displayFolder: 3 Experience
		lineageTag: 52912576-c163-468f-b09f-f57b87350a18

	/// Mean rating of late orders.
	measure 'Avg Rating Late' = CALCULATE ( [Avg Rating], fact_orders[Is Late] = TRUE () )
		formatString: 0.00
		displayFolder: 3 Experience
		lineageTag: 9c821a54-776c-4366-a6a8-e7852b2f3faf

	/// Late minus on-time mean rating; near zero means delay does not move the rating in this data.
	measure 'Rating Gap Late vs On-Time' = [Avg Rating Late] - [Avg Rating On-Time]
		formatString: +0.00;-0.00;0.00
		displayFolder: 3 Experience
		lineageTag: ccd66ce6-290b-4cd2-b4c8-e4f139b088c6

	/// Orders that were late or rated 1-2 stars.
	measure 'Poor Experience Orders' = CALCULATE ( [Orders], fact_orders[Poor Experience] = TRUE () )
		formatString: #,##0
		displayFolder: 3 Experience
		lineageTag: e8a70314-5326-44ed-96b1-45d3c928c2de

	/// Poor-experience orders / orders.
	measure 'Poor Experience Rate' = DIVIDE ( [Poor Experience Orders], [Orders] )
		formatString: 0.0%
		displayFolder: 3 Experience
		lineageTag: c890511a-32bb-458c-862f-e49ea7743717

	/// HEADLINE KPI. Sum of order totals of poor-experience orders (late or rated 1-2 stars) = Orders x Poor Experience Rate x AOV of those orders.
	measure 'Revenue at Risk' = CALCULATE ( [Revenue], fact_orders[Poor Experience] = TRUE () )
		formatString: ₹#,##0
		displayFolder: 3 Experience
		lineageTag: a2ea93a2-c98b-4bd0-b312-da8e566cfbb0

	/// Revenue at Risk / total revenue. The Experience Class filter is removed from the denominator, so a visual that hides good-experience orders still shows the share of ALL revenue.
	measure 'Revenue at Risk %' = DIVIDE ( [Revenue at Risk], CALCULATE ( [Revenue], REMOVEFILTERS ( fact_orders[Experience Class] ) ) )
		formatString: 0.0%
		displayFolder: 3 Experience
		lineageTag: ba470af1-840c-4a8a-bf08-fcadc49aaa24

	/// Orders rated 1 or 2 stars.
	measure 'Low Rating Orders' = CALCULATE ( [Orders], fact_orders[Rating] <= 2 )
		formatString: #,##0
		displayFolder: 3 Experience
		lineageTag: f4165876-dcc1-419c-bc79-c34c28ab9c55

	/// Low-rating orders / orders.
	measure 'Low Rating %' = DIVIDE ( [Low Rating Orders], [Orders] )
		formatString: 0.0%
		displayFolder: 3 Experience
		lineageTag: 5eaed796-245f-41fd-9fb7-a01d5874c896

	/// Share of orders with negative feedback sentiment.
	measure 'Negative Sentiment %' = DIVIDE ( CALCULATE ( [Orders], fact_orders[Sentiment] = "Negative" ), [Orders] )
		formatString: 0.0%
		displayFolder: 3 Experience
		lineageTag: 4f603eff-e83e-4aec-9407-1ef31b0704b0

	/// Campaign spend in assumed INR.
	measure 'Marketing Spend' = SUM ( fact_marketing[Spend] )
		formatString: ₹#,##0
		displayFolder: 4 Marketing
		lineageTag: 7fbc5b45-677b-49b6-b541-c81b53ce8a48

	/// Revenue attributed to campaigns by the source. Not order revenue (it is 2.9x total order revenue) and cannot be reconciled to orders.
	measure 'Marketing Revenue' = SUM ( fact_marketing[Attributed Revenue] )
		formatString: ₹#,##0
		displayFolder: 4 Marketing
		lineageTag: 73e63606-ac43-4684-b642-9834b6577737

	/// Return on ad spend = attributed revenue / spend, recomputed (the stored roas column did not match).
	measure ROAS = DIVIDE ( [Marketing Revenue], [Marketing Spend] )
		formatString: 0.00\x
		displayFolder: 4 Marketing
		lineageTag: 6dc7c299-5b33-49ae-ab86-da0ca2664b2e

	/// ROAS minus the all-campaign ROAS: variance for diverging colour scales.
	measure 'ROAS vs Portfolio' = IF ( NOT ISBLANK ( [ROAS] ), [ROAS] - CALCULATE ( [ROAS], REMOVEFILTERS ( fact_marketing ) ) )
		formatString: +0.00;-0.00;0.00
		displayFolder: 4 Marketing
		lineageTag: 4888cb93-d909-412e-b2a9-e93a95b47619

	/// Impressions served.
	measure 'Total Impressions' = SUM ( fact_marketing[Impressions] )
		formatString: #,##0
		displayFolder: 4 Marketing
		lineageTag: 0a5ef072-d41d-4c28-b63d-69a8edf2d798

	/// Clicks.
	measure 'Total Clicks' = SUM ( fact_marketing[Clicks] )
		formatString: #,##0
		displayFolder: 4 Marketing
		lineageTag: 7509f246-dfa7-472e-8097-55565e014d53

	/// Conversions.
	measure 'Total Conversions' = SUM ( fact_marketing[Conversions] )
		formatString: #,##0
		displayFolder: 4 Marketing
		lineageTag: 8c90f6d9-5d1b-43e3-a7ed-568fc349c61b

	/// Click-through rate = clicks / impressions.
	measure CTR = DIVIDE ( [Total Clicks], [Total Impressions] )
		formatString: 0.00%
		displayFolder: 4 Marketing
		lineageTag: 7638b34b-149d-4036-a047-93d74022bc2d

	/// Conversion rate = conversions / clicks.
	measure 'Conversion Rate' = DIVIDE ( [Total Conversions], [Total Clicks] )
		formatString: 0.0%
		displayFolder: 4 Marketing
		lineageTag: e26f6870-79c4-46d3-94e5-3a987839ee47

	/// Spend / conversions.
	measure 'Cost per Conversion' = DIVIDE ( [Marketing Spend], [Total Conversions] )
		formatString: ₹#,##0.00
		displayFolder: 4 Marketing
		lineageTag: f63429c5-fa87-4141-a42c-4217ec50d43a

	/// Spend / clicks.
	measure 'Cost per Click' = DIVIDE ( [Marketing Spend], [Total Clicks] )
		formatString: ₹#,##0.00
		displayFolder: 4 Marketing
		lineageTag: 5d643ff1-8020-447b-a66c-9c208d1df1bd

	/// Units received (monthly inventory file, summed to product x month).
	measure 'Stock Received' = SUM ( fact_inventory[Units Received] )
		formatString: #,##0
		displayFolder: 5 Inventory
		lineageTag: 35663cdf-40f0-438c-9573-816ac874f6e8

	/// Units damaged.
	measure 'Damaged Stock' = SUM ( fact_inventory[Units Damaged] )
		formatString: #,##0
		displayFolder: 5 Inventory
		lineageTag: 78d62c64-1370-4113-a18c-7e7386cd66fe

	/// Damaged units / units received.
	measure 'Damage Rate' = DIVIDE ( [Damaged Stock], [Stock Received] )
		formatString: 0.00%
		displayFolder: 5 Inventory
		lineageTag: 695c15a7-a716-4482-8d6f-f096b7fc4306

	/// Number of days in the selection that fall in a partial month (Mar 2023, Nov 2024).
	measure 'Partial Months in Context' = CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Is Full Month] = FALSE () )
		formatString: 0
		displayFolder: 6 Trends
		lineageTag: d2f15fe2-e75d-4595-8afd-f8adf98a047f

	/// 1 when neither the selected period nor the same period last year touches a partial month, else 0. Guards every YoY measure.
	measure 'Comparable Period' = VAR cur = CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Is Full Month] = FALSE () ) VAR py = CALCULATE ( COUNTROWS ( 'Date' ), SAMEPERIODLASTYEAR ( 'Date'[Date] ), 'Date'[Is Full Month] = FALSE () ) RETURN IF ( cur + py = 0, 1, 0 )
		formatString: 0
		displayFolder: 6 Trends
		lineageTag: ddee1e7f-b138-4737-9f86-b26f60820aef

	/// Revenue for the same period last year; blank when either period includes a partial month or last year has no data.
	measure 'Revenue PY' = IF ( [Comparable Period] = 1, CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: ₹#,##0
		displayFolder: 6 Trends
		lineageTag: ec2a9b46-4051-499f-a244-af4c07146b46

	/// Revenue change vs the same period last year; blank unless both periods are full months.
	measure 'Revenue YoY %' = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
		formatString: 0.0%
		displayFolder: 6 Trends
		lineageTag: 69440052-8ff7-44a7-af21-21113dad18d9

	/// Orders for the same period last year; blank when either period includes a partial month or last year has no data.
	measure 'Orders PY' = IF ( [Comparable Period] = 1, CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: #,##0
		displayFolder: 6 Trends
		lineageTag: 3f99dee9-96d0-42f4-ab63-1aeefad3886e

	/// Orders change vs the same period last year; blank unless both periods are full months.
	measure 'Orders YoY %' = DIVIDE ( [Orders] - [Orders PY], [Orders PY] )
		formatString: 0.0%
		displayFolder: 6 Trends
		lineageTag: d5e88b46-a550-4f7d-9fd3-5b8ad68d4f91

	/// AOV for the same period last year; blank when either period includes a partial month or last year has no data.
	measure 'AOV PY' = IF ( [Comparable Period] = 1, CALCULATE ( [AOV], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: ₹#,##0.00
		displayFolder: 6 Trends
		lineageTag: 0f84b2c0-8c57-4bb1-9279-31ebf42480a8

	/// AOV change vs the same period last year; blank unless both periods are full months.
	measure 'AOV YoY %' = DIVIDE ( [AOV] - [AOV PY], [AOV PY] )
		formatString: 0.0%
		displayFolder: 6 Trends
		lineageTag: 78d868d0-69c7-4c22-8d68-df46949f2202

	/// Marketing Spend for the same period last year; blank when either period includes a partial month or last year has no data.
	measure 'Marketing Spend PY' = IF ( [Comparable Period] = 1, CALCULATE ( [Marketing Spend], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		formatString: ₹#,##0
		displayFolder: 6 Trends
		lineageTag: 9b2b652d-326e-4ce9-a1ca-072fc5bd04ff

	/// Marketing Spend change vs the same period last year; blank unless both periods are full months.
	measure 'Marketing Spend YoY %' = DIVIDE ( [Marketing Spend] - [Marketing Spend PY], [Marketing Spend PY] )
		formatString: 0.0%
		displayFolder: 6 Trends
		lineageTag: 57dbfc28-eaf8-413a-8fe9-bf93fbc802cd

	/// Revenue restricted to full months (blank for Mar 2023 and Nov 2024). Use on monthly trend lines.
	measure 'Revenue (Full Months)' = CALCULATE ( [Revenue], 'Date'[Is Full Month] = TRUE () )
		formatString: ₹#,##0
		displayFolder: 6 Trends
		lineageTag: 02e695f2-b62d-4ebe-b272-48e63924ed91

	/// Orders restricted to full months.
	measure 'Orders (Full Months)' = CALCULATE ( [Orders], 'Date'[Is Full Month] = TRUE () )
		formatString: #,##0
		displayFolder: 6 Trends
		lineageTag: 6c0b32c5-5953-4674-a1d0-345c01ac160b

	/// Mean revenue per full month in the selection.
	measure 'Avg Monthly Revenue' = AVERAGEX ( CALCULATETABLE ( VALUES ( 'Date'[Month Start] ), 'Date'[Is Full Month] = TRUE () ), [Revenue] )
		formatString: ₹#,##0
		displayFolder: 6 Trends
		lineageTag: a846eef7-6db2-4296-b49c-8a7d74eabc69

	/// Mean revenue at risk per full month in the selection.
	measure 'Avg Monthly Revenue at Risk' = AVERAGEX ( CALCULATETABLE ( VALUES ( 'Date'[Month Start] ), 'Date'[Is Full Month] = TRUE () ), [Revenue at Risk] )
		formatString: ₹#,##0
		displayFolder: 6 Trends
		lineageTag: 33a3b42a-7651-41aa-ab15-70e4373d3583

	/// Revenue for cards, in crore or lakh.
	measure 'Card Revenue' = VAR v = [Revenue] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 2c2b17c1-f587-4bba-a363-916d2d354e15

	/// Revenue at Risk for cards, in crore or lakh.
	measure 'Card Revenue at Risk' = VAR v = [Revenue at Risk] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: c9d5cb3b-65d9-4d4c-aacf-126294cd38ea

	/// Orders for cards.
	measure 'Card Orders' = FORMAT ( [Orders], "#,##0", "en-US" )
		displayFolder: 7 Display
		lineageTag: 7e30c901-d1b5-4cb5-b42a-645ce8d0be40

	/// Average order value for cards.
	measure 'Card AOV' = "₹" & FORMAT ( [AOV], "#,##0.00", "en-US" )
		displayFolder: 7 Display
		lineageTag: 24510e6b-8fc6-4e71-b622-7e929c6c77a5

	/// On-time rate for cards.
	measure 'Card On-Time %' = FORMAT ( [On-Time %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 95e198ab-2ac7-4239-bb20-037e55fc3525

	/// Average rating for cards.
	measure 'Card Avg Rating' = FORMAT ( [Avg Rating], "0.00", "en-US" )
		displayFolder: 7 Display
		lineageTag: 42a893d9-2f84-4f28-942c-89d143cf31fe

	/// ROAS for cards.
	measure 'Card ROAS' = FORMAT ( [ROAS], "0.00", "en-US" ) & "x"
		displayFolder: 7 Display
		lineageTag: 913bfef5-a47b-4fef-bc2b-8e2f6595bc37

	/// Card change line for Revenue: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ Revenue' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Revenue], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Revenue], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok, FORMAT ( m, "mmm yy", "en-US" ) & ": no prior-year month", IF ( ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( DIVIDE ( c - p, p ) ), "0.0%", "en-US" ) & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 0053d741-9bb9-4e38-b1a8-ca8ccb8cc287

	/// Colour of the Revenue change line: green up, red down, grey when not comparable.
	measure 'Δ Revenue Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Revenue], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Revenue], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "#46525F", IF ( c >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
		lineageTag: ec4054bf-70cf-43ee-96ef-00e13cedd578

	/// Card change line for Orders: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ Orders' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Orders], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Orders], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok, FORMAT ( m, "mmm yy", "en-US" ) & ": no prior-year month", IF ( ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( DIVIDE ( c - p, p ) ), "0.0%", "en-US" ) & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: ac20b905-c2b4-49cd-91c6-aab6c9474d50

	/// Colour of the Orders change line: green up, red down, grey when not comparable.
	measure 'Δ Orders Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Orders], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Orders], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "#46525F", IF ( c >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
		lineageTag: 98c2b9e6-49ec-4255-80b2-4a6600a3c915

	/// Card change line for AOV: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ AOV' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [AOV], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [AOV], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok, FORMAT ( m, "mmm yy", "en-US" ) & ": no prior-year month", IF ( ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( DIVIDE ( c - p, p ) ), "0.0%", "en-US" ) & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 64119214-f3de-467e-8384-f2c533db2ea1

	/// Colour of the AOV change line: green up, red down, grey when not comparable.
	measure 'Δ AOV Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [AOV], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [AOV], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "#46525F", IF ( c >= p, "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
		lineageTag: 4925387d-619a-4fe8-b146-2fdfb4f7fa29

	/// Card change line for Revenue at Risk: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ Revenue at Risk' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Revenue at Risk], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Revenue at Risk], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ), "No prior-year month", IF ( ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( DIVIDE ( c - p, p ) ), "0.0%", "en-US" ) & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: b003ad2d-0462-4f66-9d2e-ef567b9f2d50

	/// Card change line for On-Time %: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ On-Time %' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [On-Time %], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [On-Time %], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ), "No prior-year month", IF ( ABS ( c - p ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( c - p ) * 100, "0.0", "en-US" ) & " pp" & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 4d068509-ec04-436d-8f39-6db8b0d545e7

	/// Grey for card lines that carry context, not a change.
	measure 'Δ Neutral Color' = "#46525F"
		displayFolder: 7 Display
		lineageTag: d22a3ddf-1104-4f11-bf46-d5dde22138f4

	/// Category in the current filter context (drill-through title).
	measure 'Selected Category' = SELECTEDVALUE ( dim_product[Category], "All categories" )
		displayFolder: 7 Display
		lineageTag: 1912589f-a547-466b-99e4-cfe1512003f7

	/// Campaign in the current filter context (drill-through title).
	measure 'Selected Campaign' = SELECTEDVALUE ( fact_marketing[Campaign Name], "All campaigns" )
		displayFolder: 7 Display
		lineageTag: 3467e818-25a2-49a9-a2b2-1767323ed28e

	/// Footer: source, data period, currency assumption and the refresh date.
	measure 'Footer Text' = "Blinkit sales (Kaggle, synthetic) · " & FORMAT ( CALCULATE ( MIN ( fact_orders[Order Date] ), REMOVEFILTERS () ), "mmm yyyy", "en-US" ) & " to " & FORMAT ( CALCULATE ( MAX ( fact_orders[Order Date] ), REMOVEFILTERS () ), "mmm yyyy", "en-US" ) & " · INR assumed · refreshed " & FORMAT ( MAX ( 'Refresh Info'[Refreshed] ), "d mmm yyyy", "en-US" )
		displayFolder: 7 Display
		lineageTag: ae1b85b4-c2b5-4f6c-b3e3-69f2b847a124

	/// Page 1 headline: revenue, orders, late share and revenue at risk.
	measure 'Title Overview' = VAR r = [Revenue] RETURN IF ( r >= 10000000, "₹" & FORMAT ( DIVIDE ( r, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( r >= 100000, "₹" & FORMAT ( DIVIDE ( r, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( r, "#,##0", "en-US" ) ) ) & " revenue, " & FORMAT ( [Orders], "#,##0", "en-US" ) & " orders; " & FORMAT ( [Late %], "0%", "en-US" ) & " late, " & FORMAT ( [Revenue at Risk %], "0%", "en-US" ) & " of revenue at risk"
		displayFolder: 8 Titles
		lineageTag: 202c861a-be9f-481e-8eed-94fe919d40ea

	/// Page 2 headline: leading category by line value, its share and the top-3 share.
	measure 'Title Sales' = VAR cats = ALLSELECTED ( dim_product[Category] ) VAR tot = CALCULATE ( [Line Value], ALLSELECTED ( dim_product[Category] ) ) VAR t1 = TOPN ( 1, cats, [Line Value], DESC ) VAR topName = MAXX ( t1, dim_product[Category] ) VAR topShare = DIVIDE ( MAXX ( t1, [Line Value] ), tot ) VAR top3 = DIVIDE ( SUMX ( TOPN ( 3, cats, [Line Value], DESC ), [Line Value] ), tot ) RETURN topName & " leads at " & FORMAT ( topShare, "0.0%", "en-US" ) & " of line value; top 3 hold " & FORMAT ( top3, "0%", "en-US" )
		displayFolder: 8 Titles
		lineageTag: c85f2720-8367-49b2-b73c-d45eb2375d19

	/// Monthly revenue chart title: low and high month among full months.
	measure 'Title Monthly Trend' = VAR m = CALCULATETABLE ( VALUES ( 'Date'[Month Start] ), 'Date'[Is Full Month] = TRUE () ) VAR lo = MINX ( m, [Revenue] ) VAR hi = MAXX ( m, [Revenue] ) RETURN "Monthly revenue stays between " & IF ( lo >= 10000000, "₹" & FORMAT ( DIVIDE ( lo, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( lo >= 100000, "₹" & FORMAT ( DIVIDE ( lo, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( lo, "#,##0", "en-US" ) ) ) & " and " & IF ( hi >= 10000000, "₹" & FORMAT ( DIVIDE ( hi, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( hi >= 100000, "₹" & FORMAT ( DIVIDE ( hi, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( hi, "#,##0", "en-US" ) ) ) & " (full months only)"
		displayFolder: 8 Titles
		lineageTag: 61960ddf-9150-4906-a55b-9289de50fcf3

	/// Page 3 headline: on-time share and how late the misses are.
	measure 'Title Delivery' = FORMAT ( [On-Time %], "0%", "en-US" ) & " of orders arrive on time; the late ones run " & FORMAT ( [Avg Minutes Late (Late Orders)], "0.0", "en-US" ) & " minutes over"
		displayFolder: 8 Titles
		lineageTag: 7919852f-3699-4b86-9120-ddf9a6fd44e2

	/// Page 4 headline: mean rating of late vs on-time orders and what the gap says.
	measure 'Title Experience' = VAR a = [Avg Rating Late] VAR b = [Avg Rating On-Time] VAR gap = a - b RETURN IF ( ISBLANK ( a ) || ISBLANK ( b ), "Too few late or on-time orders to compare ratings", "Late orders rate " & FORMAT ( a, "0.00", "en-US" ) & " vs " & FORMAT ( b, "0.00", "en-US" ) & " on time: " & IF ( ABS ( gap ) < 0.1, "delay does not move rating", IF ( gap < 0, "delay lowers rating", "late orders rate higher" ) ) )
		displayFolder: 8 Titles
		lineageTag: 39f86c21-864c-4b96-a657-1dea51c8fc05

	/// Revenue at Risk headline.
	measure 'Title Revenue at Risk' = VAR v = [Revenue at Risk] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) ) & " (" & FORMAT ( [Revenue at Risk %], "0%", "en-US" ) & " of revenue) at risk: late or rated 1-2 stars"
		displayFolder: 8 Titles
		lineageTag: 448b54e4-b13c-4882-bdcd-e59d76e3273f

	/// Page 5 headline: portfolio ROAS and the best and worst channel; one channel selected shows that channel's ROAS and spend.
	measure 'Title Marketing' = VAR ch = ALLSELECTED ( fact_marketing[Channel] ) VAR n = COUNTROWS ( ch ) VAR hi = MAXX ( ch, [ROAS] ) VAR lo = MINX ( ch, [ROAS] ) VAR s = [Marketing Spend] VAR hiName = MAXX ( TOPN ( 1, ch, [ROAS], DESC ), fact_marketing[Channel] ) VAR loName = MAXX ( TOPN ( 1, ch, [ROAS], ASC ), fact_marketing[Channel] ) RETURN IF ( n = 0 || ISBLANK ( [ROAS] ), "No marketing data in this selection", IF ( n = 1, hiName & ": ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x on " & IF ( s >= 10000000, "₹" & FORMAT ( DIVIDE ( s, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( s >= 100000, "₹" & FORMAT ( DIVIDE ( s, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( s, "#,##0", "en-US" ) ) ) & " spend", "ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x: " & hiName & " leads at " & FORMAT ( hi, "0.00", "en-US" ) & "x, " & loName & " trails at " & FORMAT ( lo, "0.00", "en-US" ) & "x" ) )
		displayFolder: 8 Titles
		lineageTag: 68161fb5-061b-47a9-a4ce-2549fe827942

	/// Page 6 headline: revenue, late share and ROAS.
	measure 'Title Insights' = VAR r = [Revenue] RETURN IF ( r >= 10000000, "₹" & FORMAT ( DIVIDE ( r, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( r >= 100000, "₹" & FORMAT ( DIVIDE ( r, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( r, "#,##0", "en-US" ) ) ) & " revenue, " & FORMAT ( [Late %], "0%", "en-US" ) & " late, ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x: five findings, data caveats"
		displayFolder: 8 Titles
		lineageTag: 77e2d8e6-3164-48ac-9956-9a5fd2bf6be3

	/// Page 7 headline: 2025 revenue forecast and its change vs the last 12 full months.
	measure 'Title Forecast' = VAR v = [F25 Revenue] RETURN "2025 revenue forecast " & IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) ) & ", " & FORMAT ( ABS ( [F25 vs LTM %] ), "0%", "en-US" ) & IF ( [F25 vs LTM %] < 0, " below", " above" ) & " the last 12 months"
		displayFolder: 8 Titles
		lineageTag: bb32dc35-3ce1-4418-8776-db7577e31e9b

	/// Category drill-through headline (a prompt when no single category is in context).
	measure 'Title Category Detail' = IF ( DISTINCTCOUNT ( dim_product[Category] ) <> 1, "Select a category to drill through", [Selected Category] & ": " & FORMAT ( [Category Share of All], "0.0%", "en-US" ) & " of line value, " & FORMAT ( [On-Time %], "0%", "en-US" ) & " on time, " & FORMAT ( [Avg Rating], "0.00", "en-US" ) & " stars" )
		displayFolder: 8 Titles
		lineageTag: 80276888-f6fb-491e-a724-c7366913b7c8

	/// Campaign drill-through headline (a prompt when no single campaign is in context).
	measure 'Title Campaign Detail' = VAR s = [Marketing Spend] RETURN IF ( DISTINCTCOUNT ( fact_marketing[Campaign Name] ) <> 1, "Select a campaign to drill through", [Selected Campaign] & ": ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x on " & IF ( s >= 10000000, "₹" & FORMAT ( DIVIDE ( s, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( s >= 100000, "₹" & FORMAT ( DIVIDE ( s, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( s, "#,##0", "en-US" ) ) ) & " spend" )
		displayFolder: 8 Titles
		lineageTag: f0458463-76ed-4a12-b205-92cbf1694935

	/// Revenue in ₹ lakh, for chart axes and data labels.
	measure 'Revenue ₹ L' = DIVIDE ( [Revenue], 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 7 Display
		lineageTag: 653a73c5-8b7a-461d-83ad-803e2524e8a5

	/// Line value in ₹ lakh, for chart axes and data labels.
	measure 'Line Value ₹ L' = DIVIDE ( [Line Value], 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 7 Display
		lineageTag: 51ab20e4-cb2c-4c53-9661-ac5e4d8879cc

	/// Revenue at Risk in ₹ lakh, for chart axes and data labels.
	measure 'Revenue at Risk ₹ L' = DIVIDE ( [Revenue at Risk], 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 7 Display
		lineageTag: fd01a179-e265-4751-9bd8-8741a88b9a8e

	/// Marketing spend in ₹ lakh, for chart axes and data labels.
	measure 'Marketing Spend ₹ L' = DIVIDE ( [Marketing Spend], 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 7 Display
		lineageTag: 0a72ffa1-a71d-41f8-ad07-b35804123909

	/// Attributed marketing revenue in ₹ lakh, for chart axes and data labels.
	measure 'Marketing Revenue ₹ L' = DIVIDE ( [Marketing Revenue], 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 7 Display
		lineageTag: c2d58c1e-c2c9-4893-9227-bca56c97bf2b

	/// Last full month inside the current date selection (blank when the selection holds no full month). Drives the card change lines.
	measure 'Last Full Month' = CALCULATE ( MAX ( 'Date'[Month Start] ), 'Date'[Is Full Month] = TRUE () )
		formatString: mmm yyyy
		displayFolder: 7 Display
		lineageTag: 2703512e-297c-4504-b87b-885a42cf76c5

	/// Line value share of one category against all categories, ignoring product filters (so it still works on the drill-through page).
	measure 'Category Share of All' = DIVIDE ( [Line Value], CALCULATE ( [Line Value], REMOVEFILTERS ( dim_product ) ) )
		formatString: 0.0%
		displayFolder: 1 Sales
		lineageTag: bfac6a08-107c-406f-bd17-260f4b98e85e

	/// Negative-sentiment share minus the all-orders share, in percentage points (diverging colour in the matrix).
	measure 'Negative Sentiment vs All (pp)' = IF ( NOT ISBLANK ( [Negative Sentiment %] ), ( [Negative Sentiment %] - CALCULATE ( [Negative Sentiment %], REMOVEFILTERS ( fact_orders[Feedback Category] ) ) ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 3 Experience
		lineageTag: 0dd1288c-ad32-4970-9ed2-2b0d9dffc4e1

	/// Late share for cards.
	measure 'Card Late %' = FORMAT ( [Late %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 23b58268-d38c-405e-9eac-69c2cb8e54e9

	/// Slightly delayed share for cards.
	measure 'Card Slightly Delayed %' = FORMAT ( [Slightly Delayed %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 6c7d63aa-00fa-437b-ae93-2f220a753aa4

	/// Significantly delayed share for cards.
	measure 'Card Significantly Delayed %' = FORMAT ( [Significantly Delayed %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 3cc7f746-6248-475b-95b5-6482fae0d070

	/// Mean minutes late among late orders, for cards.
	measure 'Card Avg Minutes Late' = FORMAT ( [Avg Minutes Late (Late Orders)], "0.0", "en-US" ) & " min"
		displayFolder: 7 Display
		lineageTag: 429a9ba2-4a26-41f4-8454-fa68a959151d

	/// Share of orders rated 1-2 stars, for cards.
	measure 'Card Low Rating %' = FORMAT ( [Low Rating %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 8f090b0e-8ace-40e0-95dc-68fafd444441

	/// Poor-experience rate for cards.
	measure 'Card Poor Experience Rate' = FORMAT ( [Poor Experience Rate], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 362cd218-31b9-43e4-87e2-40b32354c00c

	/// Negative sentiment share for cards.
	measure 'Card Negative Sentiment %' = FORMAT ( [Negative Sentiment %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 520f4a15-ab41-4d09-a9f2-ddac71e5aa06

	/// Repeat customer rate for cards.
	measure 'Card Repeat Rate' = FORMAT ( [Repeat Rate], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 55d0a7a4-50f1-42a0-8892-1fe92a133dfa

	/// Line value for cards, in crore or lakh.
	measure 'Card Line Value' = VAR v = [Line Value] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 5cd31b4f-0f8b-411f-970b-5c588ddafa89

	/// Units sold for cards.
	measure 'Card Units Sold' = FORMAT ( [Units Sold], "#,##0", "en-US" )
		displayFolder: 7 Display
		lineageTag: 3f3c0dfc-5218-4dbf-a949-693101378804

	/// Average stored margin for cards.
	measure 'Card Avg Margin %' = FORMAT ( [Avg Margin %], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: f420bb21-3dd7-4840-8b0b-5a6653e09dda

	/// Revenue per ordering customer for cards.
	measure 'Card Revenue per Customer' = "₹" & FORMAT ( [Revenue per Customer], "#,##0", "en-US" )
		displayFolder: 7 Display
		lineageTag: 159ebcee-77fb-4c24-ab3a-11bc4e352064

	/// Marketing spend for cards.
	measure 'Card Marketing Spend' = VAR v = [Marketing Spend] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 3e6c7b26-552c-4e53-94d1-3ed5d1fbcfce

	/// Attributed marketing revenue for cards.
	measure 'Card Marketing Revenue' = VAR v = [Marketing Revenue] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: edbadb06-02b3-4d4b-a573-4d0162399aae

	/// Impressions in millions, for cards.
	measure 'Card Impressions' = FORMAT ( DIVIDE ( [Total Impressions], 1000000 ), "0.00", "en-US" ) & " M"
		displayFolder: 7 Display
		lineageTag: 26ad9d2b-e228-4b07-b800-3c556ae84f93

	/// Clicks in millions, for cards.
	measure 'Card Clicks' = FORMAT ( DIVIDE ( [Total Clicks], 1000000 ), "0.00", "en-US" ) & " M"
		displayFolder: 7 Display
		lineageTag: 4c89b67d-6a79-4d57-84af-933c2f7fc74a

	/// Conversions for cards.
	measure 'Card Conversions' = FORMAT ( [Total Conversions], "#,##0", "en-US" )
		displayFolder: 7 Display
		lineageTag: 0a498074-331b-4440-80c2-5f3f1d0eb9fc

	/// Card line: repeat rate against the 70% target, in points.
	measure 'Δ Repeat Rate' = IF ( ABS ( [Repeat Rate] - 0.7 ) < 0.0005, "● ", IF ( [Repeat Rate] < 0.7, "▼ ", "▲ " ) ) & FORMAT ( ABS ( [Repeat Rate] - 0.7 ) * 100, "0.0", "en-US" ) & " pp vs 70% target"
		displayFolder: 7 Display
		lineageTag: 0b505f6f-c903-4424-8b79-f4ea9d574944

	/// Colour of the On-Time % change line: green is good, red is bad, grey when not comparable or when direction has no good side.
	measure 'Δ On-Time % Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [On-Time %], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [On-Time %], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ) || ABS ( c - p ) * 100 < 0.05, "#46525F", IF ( ( c >= p ) = TRUE (), "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
