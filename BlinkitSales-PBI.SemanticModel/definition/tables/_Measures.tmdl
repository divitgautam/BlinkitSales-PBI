		lineageTag: 92800620-05b9-4ef7-9a5d-da3bf039cf1f

	/// Card change line for Conversions: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ Conversions' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Total Conversions], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Total Conversions], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ), "No prior-year month", IF ( ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( DIVIDE ( c - p, p ) ), "0.0%", "en-US" ) & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 56891ee2-b659-44b7-85ca-c63dba8d9bc1

	/// Colour of the Conversions change line: green is good, red is bad, grey when not comparable or when direction has no good side.
	measure 'Δ Conversions Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Total Conversions], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Total Conversions], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ) || ABS ( DIVIDE ( c - p, p ) ) * 100 < 0.05, "#46525F", IF ( ( c >= p ) = TRUE (), "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
		lineageTag: 4c15fa26-fd17-470e-bdcb-d7d098800893

	/// Card change line for CTR: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ CTR' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [CTR], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [CTR], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ), "No prior-year month", IF ( ABS ( c - p ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( c - p ) * 100, "0.0", "en-US" ) & " pp" & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 944a79dd-89ba-4c64-9ccb-66bf131eb852

	/// Colour of the CTR change line: green is good, red is bad, grey when not comparable or when direction has no good side.
	measure 'Δ CTR Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [CTR], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [CTR], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ) || ABS ( c - p ) * 100 < 0.05, "#46525F", IF ( ( c >= p ) = TRUE (), "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
		lineageTag: eb361ba7-4f82-41b6-87ba-ed3d24a25243

	/// Card change line for Conversion Rate: last full month in the selection vs the same month a year earlier; says so when there is no full prior-year month.
	measure 'Δ Conversion Rate' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Conversion Rate], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Conversion Rate], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( ISBLANK ( m ), "No full month selected", IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ), "No prior-year month", IF ( ABS ( c - p ) * 100 < 0.05, "● ", IF ( c >= p, "▲ ", "▼ " ) ) & FORMAT ( ABS ( c - p ) * 100, "0.0", "en-US" ) & " pp" & " " & FORMAT ( m, "mmm yy", "en-US" ) & " vs " & FORMAT ( pm, "mmm yy", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 544587fd-71cb-4e5d-a77c-72852bd440e2

	/// Colour of the Conversion Rate change line: green is good, red is bad, grey when not comparable or when direction has no good side.
	measure 'Δ Conversion Rate Color' = VAR m = [Last Full Month] VAR pm = EDATE ( m, -12 ) VAR ok = NOT ISBLANK ( m ) && CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), 'Date'[Month Start] = pm, 'Date'[Is Full Month] = TRUE () ) > 0 VAR c = CALCULATE ( [Conversion Rate], ALL ( 'Date' ), 'Date'[Month Start] = m ) VAR p = CALCULATE ( [Conversion Rate], ALL ( 'Date' ), 'Date'[Month Start] = pm ) RETURN IF ( NOT ok || ISBLANK ( c ) || ISBLANK ( p ) || ABS ( c - p ) * 100 < 0.05, "#46525F", IF ( ( c >= p ) = TRUE (), "#1E7F4B", "#C0392B" ) )
		displayFolder: 7 Display
		lineageTag: d09cf2d6-7708-4cfd-ae66-79725ffeba36

	/// Grey for card lines that carry context, not a change.
	measure 'Δ Neutral Color' = "#46525F"
		displayFolder: 7 Display
		lineageTag: 124b439e-bf73-4f8e-a958-1b7c93d2d07d

	/// Category in the current filter context (drill-through title).
	measure 'Selected Category' = SELECTEDVALUE ( dim_product[Category], "All categories" )
		displayFolder: 7 Display
		lineageTag: 8af4ee60-0f99-41dc-be12-70ea2355f1d2

	/// Campaign in the current filter context (drill-through title).
	measure 'Selected Campaign' = SELECTEDVALUE ( fact_marketing[Campaign Name], "All campaigns" )
		displayFolder: 7 Display
		lineageTag: ac2a8864-8453-4507-a831-78ed1afde8b1

	/// Footer: source, data period, currency assumption and the refresh date.
	measure 'Footer Text' = "Blinkit sales (Kaggle, synthetic) · " & FORMAT ( CALCULATE ( MIN ( fact_orders[Order Date] ), REMOVEFILTERS () ), "mmm yyyy", "en-US" ) & " to " & FORMAT ( CALCULATE ( MAX ( fact_orders[Order Date] ), REMOVEFILTERS () ), "mmm yyyy", "en-US" ) & " · INR assumed · refreshed " & FORMAT ( MAX ( 'Refresh Info'[Refreshed] ), "d mmm yyyy", "en-US" )
		displayFolder: 7 Display
		lineageTag: 3f4e287d-b0a6-4046-815c-e87c7b6991d4

	/// Actual monthly revenue, ₹ lakh; blank outside its months.
	measure 'Fcst Actual ₹ L' = DIVIDE ( SUM ( Forecast[Actual] ), 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 9 Forecast
		lineageTag: d18d04d6-3486-44d4-95c7-6e09f48b58a8

	/// Forecast monthly revenue (flat level), ₹ lakh; blank outside its months.
	measure 'Fcst Forecast ₹ L' = DIVIDE ( SUM ( Forecast[Forecast] ), 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 9 Forecast
		lineageTag: 2488a422-d7e8-4a1e-a4ec-c775754944f5

	/// Low end of the 80% band, ₹ lakh; blank outside its months.
	measure 'Fcst Low ₹ L' = DIVIDE ( SUM ( Forecast[Low 80] ), 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 9 Forecast
		lineageTag: ad164533-91b2-485f-9423-93111de12caf

	/// High end of the 80% band, ₹ lakh; blank outside its months.
	measure 'Fcst High ₹ L' = DIVIDE ( SUM ( Forecast[High 80] ), 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 9 Forecast
		lineageTag: 26765a78-203b-4ee5-9e41-a6a1a64f29c5

	/// 2025 revenue forecast: the sum of the twelve forecast months (flat level model).
	measure 'F25 Revenue' = CALCULATE ( SUM ( Forecast[Forecast] ), Forecast[Year] = 2025, Forecast[Kind] = "Forecast" )
		formatString: ₹#,##0
		displayFolder: 9 Forecast
		lineageTag: cab52c27-e92b-4319-8a1b-306299faac34

	/// 2025 low case: sum of the monthly 80% lower bounds.
	measure 'F25 Low' = CALCULATE ( SUM ( Forecast[Low 80] ), Forecast[Year] = 2025, Forecast[Kind] = "Forecast" )
		formatString: ₹#,##0
		displayFolder: 9 Forecast
		lineageTag: 59eee256-ed49-4388-b481-63df629091f2

	/// 2025 high case: sum of the monthly 80% upper bounds.
	measure 'F25 High' = CALCULATE ( SUM ( Forecast[High 80] ), Forecast[Year] = 2025, Forecast[Kind] = "Forecast" )
		formatString: ₹#,##0
		displayFolder: 9 Forecast
		lineageTag: 93df89d6-3091-4d00-8f6e-2d492b97d90e

	/// Revenue of the last 12 full months (Nov 2023 to Oct 2024).
	measure 'LTM Revenue' = VAR lastA = CALCULATE ( MAX ( Forecast[Month Start] ), Forecast[Kind] = "Actual" ) RETURN CALCULATE ( SUM ( Forecast[Actual] ), Forecast[Month Start] > EDATE ( lastA, -12 ), Forecast[Month Start] <= lastA )
		formatString: ₹#,##0
		displayFolder: 9 Forecast
		lineageTag: 31f34df4-a74e-4106-9ae6-0bf479f4e26d

	/// 2025 forecast vs the last 12 full months.
	measure 'F25 vs LTM %' = DIVIDE ( [F25 Revenue] - [LTM Revenue], [LTM Revenue] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 9 Forecast
		lineageTag: 9d8ca4ea-f498-42dc-8796-8d9de81dfa56

	/// Annual lever value in ₹ (types are not additive).
	measure 'Lever Value' = SUM ( Levers[Annual Value] )
		formatString: ₹#,##0
		displayFolder: 9 Forecast
		lineageTag: 4b3015de-f7a3-48d4-93f4-d33cc629dcc7

	/// Annual lever value in ₹ lakh, for the lever chart.
	measure 'Lever Value ₹ L' = DIVIDE ( SUM ( Levers[Annual Value] ), 100000 )
		formatString: ₹#,##0.00 \L
		displayFolder: 9 Forecast
		lineageTag: 8bddca48-9304-4891-92d1-cf8319512b38

	/// Lever value as a share of the last 12 full months of revenue.
	measure 'Lever Value % of Revenue' = SUM ( Levers[Pct of Revenue] )
		formatString: 0.0%
		displayFolder: 9 Forecast
		lineageTag: eacbb3cb-9f99-4952-945a-24d49579b495

	/// Revenue at Risk removed when late deliveries and 1-2 star ratings are both cut by 5 points: ONE scenario on late-or-low-rated orders (forecast.py), not the sum of two levers.
	measure 'Lever Exposure Removed' = CALCULATE ( SUM ( Levers[Annual Value] ), Levers[Lever Type] = "Exposure removed (combined)" )
		formatString: ₹#,##0
		displayFolder: 9 Forecast
		lineageTag: 236ba532-d88f-40dd-8679-5bbd738e7027

	/// 2025 forecast for cards.
	measure 'Card F25 Revenue' = VAR v = [F25 Revenue] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 0be56c83-5c2e-4c85-bbe9-0980a257aa7a

	/// 80% band of the 2025 forecast for cards.
	measure 'Card F25 Range' = VAR lo = [F25 Low] VAR hi = [F25 High] RETURN IF ( lo >= 10000000, "₹" & FORMAT ( DIVIDE ( lo, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( lo >= 100000, "₹" & FORMAT ( DIVIDE ( lo, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( lo, "#,##0", "en-US" ) ) ) & " to " & IF ( hi >= 10000000, "₹" & FORMAT ( DIVIDE ( hi, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( hi >= 100000, "₹" & FORMAT ( DIVIDE ( hi, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( hi, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 3a3335cc-044d-4e18-8f5e-a250c00e7aff

	/// 2025 forecast vs the last 12 months, as text.
	measure 'Card F25 vs LTM' = FORMAT ( ABS ( [F25 vs LTM %] ), "0.0%", "en-US" ) & IF ( [F25 vs LTM %] < 0, " below", " above" )
		displayFolder: 7 Display
		lineageTag: 1b7d4bfd-360e-46f2-bcd1-cdbabc1872f0

	/// Backtest error (MAPE) of the forecast model, from _build/forecast.py.
	measure 'Card Backtest' = "2.8%"
		displayFolder: 7 Display
		lineageTag: de057b55-f193-4ef8-bc84-77938c6a8aae

	/// Annual exposure removed by the two experience levers, for cards.
	measure 'Card Lever Exposure' = VAR v = [Lever Exposure Removed] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: d7b6fab3-2b86-4698-91e4-90498b886afb

	/// Card line: where the last-12-month revenue sits against the 2025 80% range.
	measure 'Δ F25 Range' = IF ( [LTM Revenue] >= [F25 Low] && [LTM Revenue] <= [F25 High], "Last 12 months inside range", IF ( [LTM Revenue] > [F25 High], "Last 12 months above range", "Last 12 months below range" ) )
		displayFolder: 7 Display
		lineageTag: 31654b0a-677e-40a7-be39-897175f77eb4

	/// Card line: the gap between the 2025 forecast and the last 12 full months, in rupees.
	measure 'Δ F25 vs LTM' = VAR g = [F25 Revenue] - [LTM Revenue] RETURN IF ( g < 0, "-", "+" ) & IF ( ABS ( g ) >= 10000000, "₹" & FORMAT ( DIVIDE ( ABS ( g ), 10000000 ), "0.00", "en-US" ) & " Cr", IF ( ABS ( g ) >= 100000, "₹" & FORMAT ( DIVIDE ( ABS ( g ), 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( ABS ( g ), "#,##0", "en-US" ) ) ) & " vs " & IF ( [LTM Revenue] >= 10000000, "₹" & FORMAT ( DIVIDE ( [LTM Revenue], 10000000 ), "0.00", "en-US" ) & " Cr", IF ( [LTM Revenue] >= 100000, "₹" & FORMAT ( DIVIDE ( [LTM Revenue], 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( [LTM Revenue], "#,##0", "en-US" ) ) ) & " (12 mo)"
		displayFolder: 7 Display
		lineageTag: bcc54511-f374-4270-96a5-898a01f0dc93

	/// Card line: backtest error against a 5% target.
	measure 'Δ Backtest' = "Within the 5% target"
		displayFolder: 7 Display
		lineageTag: f8623b79-b864-4fba-bb45-dba70aa81204

	/// Page 1 headline: revenue, orders, late share and revenue at risk.
	measure 'Title Overview' = VAR r = [Revenue] RETURN IF ( r >= 10000000, "₹" & FORMAT ( DIVIDE ( r, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( r >= 100000, "₹" & FORMAT ( DIVIDE ( r, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( r, "#,##0", "en-US" ) ) ) & " revenue, " & FORMAT ( [Orders], "#,##0", "en-US" ) & " orders; " & FORMAT ( [Late %], "0%", "en-US" ) & " late, " & FORMAT ( [Revenue at Risk %], "0%", "en-US" ) & " of revenue at risk"
		displayFolder: 8 Titles
		lineageTag: 92a7815c-0ebf-40b4-91c4-f358108c069b

	/// Page 2 headline: leading category by line value, its share and the top-3 share.
	measure 'Title Sales' = VAR cats = ALLSELECTED ( dim_product[Category] ) VAR tot = CALCULATE ( [Line Value], ALLSELECTED ( dim_product[Category] ) ) VAR t1 = TOPN ( 1, cats, [Line Value], DESC ) VAR topName = MAXX ( t1, dim_product[Category] ) VAR topShare = DIVIDE ( MAXX ( t1, [Line Value] ), tot ) VAR top3 = DIVIDE ( SUMX ( TOPN ( 3, cats, [Line Value], DESC ), [Line Value] ), tot ) RETURN topName & " leads at " & FORMAT ( topShare, "0.0%", "en-US" ) & " of line value; top 3 hold " & FORMAT ( top3, "0%", "en-US" )
		displayFolder: 8 Titles
		lineageTag: a7ec53d2-3e40-48b0-a27f-ab031322772b

	/// Monthly revenue chart title: low and high month among full months.
	measure 'Title Monthly Trend' = VAR m = CALCULATETABLE ( VALUES ( 'Date'[Month Start] ), 'Date'[Is Full Month] = TRUE () ) VAR lo = MINX ( m, [Revenue] ) VAR hi = MAXX ( m, [Revenue] ) RETURN "Monthly revenue stays between " & IF ( lo >= 10000000, "₹" & FORMAT ( DIVIDE ( lo, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( lo >= 100000, "₹" & FORMAT ( DIVIDE ( lo, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( lo, "#,##0", "en-US" ) ) ) & " and " & IF ( hi >= 10000000, "₹" & FORMAT ( DIVIDE ( hi, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( hi >= 100000, "₹" & FORMAT ( DIVIDE ( hi, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( hi, "#,##0", "en-US" ) ) ) & " (full months only)"
		displayFolder: 8 Titles
		lineageTag: 0aa56c67-5fa8-4efd-930e-59b25c574823

	/// Page 3 headline: on-time share and how late the misses are.
	measure 'Title Delivery' = FORMAT ( [On-Time %], "0%", "en-US" ) & " of orders arrive on time; the late ones run " & FORMAT ( [Avg Minutes Late (Late Orders)], "0.0", "en-US" ) & " minutes over"
		displayFolder: 8 Titles
		lineageTag: ae392c53-efc9-4ad2-9f30-8e9625c1b1e7

	/// Page 4 headline: mean rating of late vs on-time orders and what the gap says.
	measure 'Title Experience' = VAR a = [Avg Rating Late] VAR b = [Avg Rating On-Time] VAR gap = a - b RETURN IF ( ISBLANK ( a ) || ISBLANK ( b ), "Too few late or on-time orders to compare ratings", "Late orders rate " & FORMAT ( a, "0.00", "en-US" ) & " vs " & FORMAT ( b, "0.00", "en-US" ) & " on time: " & IF ( ABS ( gap ) < 0.1, "delay does not move rating", IF ( gap < 0, "delay lowers rating", "late orders rate higher" ) ) )
		displayFolder: 8 Titles
		lineageTag: d16fe9f0-ede8-4893-bac4-312903c48302

	/// Revenue at Risk headline.
	measure 'Title Revenue at Risk' = VAR v = [Revenue at Risk] RETURN IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) ) & " (" & FORMAT ( [Revenue at Risk %], "0%", "en-US" ) & " of revenue) at risk: late or rated 1-2 stars"
		displayFolder: 8 Titles
		lineageTag: 8fcacb9f-909b-425f-bd02-c7942c8b0129

	/// Page 5 headline: portfolio ROAS and the best and worst channel; one channel selected shows that channel's ROAS and spend.
	measure 'Title Marketing' = VAR ch = ALLSELECTED ( fact_marketing[Channel] ) VAR n = COUNTROWS ( ch ) VAR hi = MAXX ( ch, [ROAS] ) VAR lo = MINX ( ch, [ROAS] ) VAR s = [Marketing Spend] VAR hiName = MAXX ( TOPN ( 1, ch, [ROAS], DESC ), fact_marketing[Channel] ) VAR loName = MAXX ( TOPN ( 1, ch, [ROAS], ASC ), fact_marketing[Channel] ) RETURN IF ( n = 0 || ISBLANK ( [ROAS] ), "No marketing data in this selection", IF ( n = 1, hiName & ": ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x on " & IF ( s >= 10000000, "₹" & FORMAT ( DIVIDE ( s, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( s >= 100000, "₹" & FORMAT ( DIVIDE ( s, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( s, "#,##0", "en-US" ) ) ) & " spend", "ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x: " & hiName & " leads at " & FORMAT ( hi, "0.00", "en-US" ) & "x, " & loName & " trails at " & FORMAT ( lo, "0.00", "en-US" ) & "x" ) )
		displayFolder: 8 Titles
		lineageTag: a987126f-f984-4d0c-b534-0dc853ad1f1b

	/// Page 6 headline: revenue, late share and ROAS.
	measure 'Title Insights' = VAR r = [Revenue] RETURN IF ( r >= 10000000, "₹" & FORMAT ( DIVIDE ( r, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( r >= 100000, "₹" & FORMAT ( DIVIDE ( r, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( r, "#,##0", "en-US" ) ) ) & " revenue, " & FORMAT ( [Late %], "0%", "en-US" ) & " late, ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x: five findings, data caveats"
		displayFolder: 8 Titles
		lineageTag: e94c775e-fe31-45a9-bb64-99a37e6a43fc

	/// Page 7 headline: 2025 revenue forecast and its change vs the last 12 full months.
	measure 'Title Forecast' = VAR v = [F25 Revenue] RETURN "2025 revenue forecast " & IF ( v >= 10000000, "₹" & FORMAT ( DIVIDE ( v, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( v >= 100000, "₹" & FORMAT ( DIVIDE ( v, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( v, "#,##0", "en-US" ) ) ) & ", " & FORMAT ( ABS ( [F25 vs LTM %] ), "0%", "en-US" ) & IF ( [F25 vs LTM %] < 0, " below", " above" ) & " the last 12 months"
		displayFolder: 8 Titles
		lineageTag: c72fabdf-31ac-429d-944a-22e8fe22a6b6

	/// Category drill-through headline (a prompt when no single category is in context).
	measure 'Title Category Detail' = IF ( DISTINCTCOUNT ( dim_product[Category] ) <> 1, "Select a category to drill through", [Selected Category] & ": " & FORMAT ( [Category Share of All], "0.0%", "en-US" ) & " of line value, " & FORMAT ( [On-Time %], "0%", "en-US" ) & " on time, " & FORMAT ( [Avg Rating], "0.00", "en-US" ) & " stars" )
		displayFolder: 8 Titles
		lineageTag: 6158e4c6-7f25-4293-ac3c-daa4b1c50f4d

	/// Campaign drill-through headline (a prompt when no single campaign is in context).
	measure 'Title Campaign Detail' = VAR s = [Marketing Spend] RETURN IF ( DISTINCTCOUNT ( fact_marketing[Campaign Name] ) <> 1, "Select a campaign to drill through", [Selected Campaign] & ": ROAS " & FORMAT ( [ROAS], "0.00", "en-US" ) & "x on " & IF ( s >= 10000000, "₹" & FORMAT ( DIVIDE ( s, 10000000 ), "0.00", "en-US" ) & " Cr", IF ( s >= 100000, "₹" & FORMAT ( DIVIDE ( s, 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( s, "#,##0", "en-US" ) ) ) & " spend" )
		displayFolder: 8 Titles
		lineageTag: d6a1b7a7-305a-43f8-824e-d9d9a373d4c1

	/// Line value in ₹ lakh with two decimals and no unit text, for the compact category x month heat map.
	measure 'Line Value ₹ L Plain' = DIVIDE ( [Line Value], 100000 )
		formatString: 0.00 \L
		displayFolder: 7 Display
		lineageTag: 809ce6fd-4da1-4fdd-8ec4-8e1d0967f929

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["AVOID_DUPLICATE_MEASURES"]}

	/// Click-through rate for cards.
	measure 'Card CTR' = FORMAT ( [CTR], "0.00%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 01f3b5f9-4b24-41b0-94f6-9a81d566b9ef

	/// Conversion rate for cards.
	measure 'Card Conversion Rate' = FORMAT ( [Conversion Rate], "0.0%", "en-US" )
		displayFolder: 7 Display
		lineageTag: 9560d5b8-0b82-49bb-b919-23a0dd8d1fbe

	/// Card line: combined exposure removed as a share of last-12-month revenue.
	measure 'Δ Lever Exposure' = FORMAT ( DIVIDE ( [Lever Exposure Removed], [LTM Revenue] ), "0.0%", "en-US" ) & " of 12-mo revenue " & IF ( [LTM Revenue] >= 10000000, "₹" & FORMAT ( DIVIDE ( [LTM Revenue], 10000000 ), "0.00", "en-US" ) & " Cr", IF ( [LTM Revenue] >= 100000, "₹" & FORMAT ( DIVIDE ( [LTM Revenue], 100000 ), "0.00", "en-US" ) & " L", "₹" & FORMAT ( [LTM Revenue], "#,##0", "en-US" ) ) )
		displayFolder: 7 Display
		lineageTag: 8685ac12-1e8c-4f36-8a75-a136a6f25f49

	/// Card line: 2025 forecast vs the last 12 full months.
	measure 'Δ F25 Revenue' = IF ( ABS ( [F25 vs LTM %] ) < 0.0005, "● ", IF ( [F25 vs LTM %] < 0, "▼ ", "▲ " ) ) & FORMAT ( ABS ( [F25 vs LTM %] ), "0.0%", "en-US" ) & " vs last 12 months"
		displayFolder: 7 Display
		lineageTag: 6e2a537b-a967-4ddb-b172-c04ba9cfa815

	/// Colour of the forecast change line.
	measure 'Δ F25 Revenue Color' = IF ( ABS ( [F25 vs LTM %] ) < 0.0005, "#46525F", IF ( [F25 vs LTM %] < 0, "#C0392B", "#1E7F4B" ) )
		displayFolder: 7 Display
		lineageTag: 2a0b05c7-f252-4aa5-af1a-658d6d04c6f5

	column Hidden
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: ea94220d-00b1-452e-9b23-59e6079132a5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Hidden]

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["UNNECESSARY_COLUMNS"]}

	partition _Measures = calculated
		mode: import
		source = ROW ( "Hidden", BLANK () )

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["ENSURE_TABLES_HAVE_RELATIONSHIPS", "REMOVE_UNNECESSARY_COLUMNS"]}

