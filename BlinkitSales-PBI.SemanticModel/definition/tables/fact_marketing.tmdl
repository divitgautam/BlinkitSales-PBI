/// One row per campaign record (5,400). No key to orders: attributed revenue is a separate star and is not order revenue. Source: data/clean/fact_marketing.csv.
table fact_marketing
	lineageTag: 1e33d8a2-9919-4015-8a88-ec406efe7510

	/// Campaign name (9 campaigns).
	column 'Campaign Name'
		dataType: string
		lineageTag: 6ffe696f-be36-48dc-bd5d-65bb99f77999
		summarizeBy: none
		sourceColumn: Campaign Name

		annotation SummarizationSetBy = User

	/// Record date. Foreign key to the Date table.
	column 'Campaign Date'
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy
		isAvailableInMdx: false
		lineageTag: 6ff40811-151a-4b17-90f2-558bb2943870
		summarizeBy: none
		sourceColumn: Campaign Date

		annotation SummarizationSetBy = User

	/// App, Email, SMS or Social Media.
	column Channel
		dataType: string
		lineageTag: f6c71fa7-09dd-4a58-879a-7ce7d93f3157
		summarizeBy: none
		sourceColumn: Channel

		annotation SummarizationSetBy = User

	/// Everyone (campaigns aimed at all users, not a total), Inactive, New Users or Premium.
	column 'Target Audience'
		dataType: string
		lineageTag: 38a1b830-7341-47e3-8edb-72867bee4070
		summarizeBy: none
		sourceColumn: Target Audience

		annotation SummarizationSetBy = User

	/// Impressions served. Source of Total Impressions.
	column Impressions
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 2325d8e4-17ce-411d-8dd2-a609ccf07653
		summarizeBy: none
		sourceColumn: Impressions

		annotation SummarizationSetBy = User

	/// Clicks. Source of Total Clicks.
	column Clicks
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 61f0ea23-becd-4765-9c6a-7d8a48df6069
		summarizeBy: none
		sourceColumn: Clicks

		annotation SummarizationSetBy = User

	/// Conversions. Source of Total Conversions.
	column Conversions
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 10e7aa85-fd4c-4836-a714-d0d4e14559f2
		summarizeBy: none
		sourceColumn: Conversions

		annotation SummarizationSetBy = User

	/// Campaign spend in assumed INR.
	column Spend
		dataType: decimal
		isHidden
		formatString: ₹#,##0.00
		isAvailableInMdx: false
		lineageTag: e459550e-242e-49b6-a629-81858aafd896
		summarizeBy: none
		sourceColumn: Spend

		annotation SummarizationSetBy = User

	/// Revenue attributed to the campaign by the source (not order revenue).
	column 'Attributed Revenue'
		dataType: decimal
		isHidden
		formatString: ₹#,##0.00
		isAvailableInMdx: false
		lineageTag: cdf2bcd1-ca64-43fb-ad3d-25861659af7e
		summarizeBy: none
		sourceColumn: Attributed Revenue

		annotation SummarizationSetBy = User

	partition fact_marketing = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\" & SourceFolder & "\fact_marketing.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"campaign_name", "date", "channel", "target_audience", "impressions", "clicks", "conversions", "spend", "attributed_revenue"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"campaign_name", type text}, {"date", type date}, {"channel", type text}, {"target_audience", type text}, {"impressions", Int64.Type}, {"clicks", Int64.Type}, {"conversions", Int64.Type}, {"spend", Currency.Type}, {"attributed_revenue", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"campaign_name", "Campaign Name"}, {"date", "Campaign Date"}, {"channel", "Channel"}, {"target_audience", "Target Audience"}, {"impressions", "Impressions"}, {"clicks", "Clicks"}, {"conversions", "Conversions"}, {"spend", "Spend"}, {"attributed_revenue", "Attributed Revenue"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["FIRST_LETTER_OF_OBJECTS_MUST_BE_CAPITALIZED"]}

