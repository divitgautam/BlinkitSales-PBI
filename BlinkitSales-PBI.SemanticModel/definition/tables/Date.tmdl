/// Calendar of whole months from Mar 2023 to Nov 2024, shared by orders, marketing and inventory; marked as the date table.
table Date
	lineageTag: 209560ae-f23c-47d5-848e-925af5fe7255
	dataCategory: Time

	/// Calendar date (key).
	column Date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: ae95a6cf-9257-4f27-8b07-6e07dca31d72
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: ab7d54ec-5cd5-4785-b99b-9c997e2f439c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	/// Calendar quarter, Q1-Q4.
	column Quarter
		dataType: string
		lineageTag: e053446f-ee76-44ee-82c7-21af6b7e417a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	/// Month number, 1-12 (sorts Month).
	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: 36e93e93-727c-44cf-a0bc-82496412f592
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	/// Month name, e.g. Jan.
	column Month
		dataType: string
		sortByColumn: 'Month No'
		lineageTag: aa12bf5d-b0a9-4b88-9864-b23a301bab44
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]

	/// First day of the month.
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: d187814a-afee-43bf-b237-5be4b573d3ff
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

	/// Month label, e.g. Mar 24.
	column 'Year Month'
		dataType: string
		sortByColumn: 'Year Month Key'
		lineageTag: d2e22347-90d8-4f21-bfd9-490c5738a70d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

	/// yyyymm number (sorts Year Month).
	column 'Year Month Key'
		dataType: int64
		formatString: 0
		lineageTag: 56a72449-e8ef-4a22-966c-995a0a56c3d2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

	/// Weekday number, Monday = 1 (sorts Weekday).
	column 'Weekday No'
		dataType: int64
		formatString: 0
		lineageTag: 766074aa-0eb1-40f2-a4f0-88e3bfd5e13b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday No]

	/// Weekday name, e.g. Mon.
	column Weekday
		dataType: string
		sortByColumn: 'Weekday No'
		lineageTag: 97aa33d8-45c1-47af-9bba-ef04fb511ac8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]

	/// FALSE for the first and last month of the order data (Mar 2023 and Nov 2024), which are partial; exclude them from trends and YoY.
	column 'Is Full Month'
		dataType: boolean
		lineageTag: 9fafad2f-64e0-4b3e-ad28-0a0bcc964588
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Full Month]

	partition Date = calculated
		mode: import
		source = VAR lo = MIN ( MIN ( fact_orders[Order Date] ), MIN ( fact_marketing[Campaign Date] ), MIN ( fact_inventory[Month Start] ) ) VAR hi = MAX ( MAX ( fact_orders[Order Date] ), MAX ( fact_marketing[Campaign Date] ), MAX ( fact_inventory[Month Start] ) ) VAR firstMonth = DATE ( YEAR ( MIN ( fact_orders[Order Date] ) ), MONTH ( MIN ( fact_orders[Order Date] ) ), 1 ) VAR lastMonth = DATE ( YEAR ( MAX ( fact_orders[Order Date] ) ), MONTH ( MAX ( fact_orders[Order Date] ) ), 1 ) RETURN ADDCOLUMNS ( CALENDAR ( DATE ( YEAR ( lo ), MONTH ( lo ), 1 ), EOMONTH ( hi, 0 ) ), "Year", YEAR ( [Date] ), "Quarter", "Q" & QUARTER ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM", "en-US" ), "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ), "Year Month", FORMAT ( [Date], "MMM yy", "en-US" ), "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ), "Weekday No", WEEKDAY ( [Date], 2 ), "Weekday", FORMAT ( [Date], "ddd", "en-US" ), "Is Full Month", NOT ( DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ) = firstMonth || DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ) = lastMonth ) )
