/// Calendar of whole months from Mar 2023 to Nov 2024, shared by orders, marketing and inventory; marked as the date table.
table Date
	lineageTag: 753ad3d9-f293-491a-bacb-40a2da6b1e47
	dataCategory: Time

	/// Calendar date (key).
	column Date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: 25f8bf5a-2f5c-4532-8363-a159bc8031bb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: 0e7191d6-3424-4cfa-8999-2aac1cb086e5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	/// Calendar quarter, Q1-Q4.
	column Quarter
		dataType: string
		lineageTag: 5c207552-1305-402f-8953-6cd8cd54c311
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	/// Month number, 1-12 (sorts Month).
	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: 98d1135d-4005-42a0-8ce5-0b84c5c66aeb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	/// Month name, e.g. Jan.
	column Month
		dataType: string
		lineageTag: db7a4f09-6c85-48bd-b8dd-38b585dc41b4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month No'

	/// First day of the month.
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 1bfcbe67-e695-421f-8552-5ff32052c733
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

	/// Month label, e.g. Mar 24.
	column 'Year Month'
		dataType: string
		lineageTag: eab2362b-c3ec-476b-b0fe-ad0d2cd4a7de
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

	/// yyyymm number (sorts Year Month).
	column 'Year Month Key'
		dataType: int64
		formatString: 0
		lineageTag: a1bd314c-435e-4557-a31e-cf02590d68a2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

	/// Weekday number, Monday = 1 (sorts Weekday).
	column 'Weekday No'
		dataType: int64
		formatString: 0
		lineageTag: ca7de749-617a-4546-abb4-02ef4063d092
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday No]

	/// Weekday name, e.g. Mon.
	column Weekday
		dataType: string
		lineageTag: 40922051-6ef0-4696-b111-0b19b61dec2f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday No'

	/// FALSE for the first and last month of the order data (Mar 2023 and Nov 2024), which are partial; exclude them from trends and YoY.
	column 'Is Full Month'
		dataType: boolean
		lineageTag: 602d709f-e751-443e-8302-6500977bcb66
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Full Month]

	partition Date = calculated
		mode: import
		source = VAR lo = MIN ( MIN ( MIN ( fact_orders[Order Date] ), MIN ( fact_marketing[Campaign Date] ) ), MIN ( fact_inventory[Month Start] ) ) VAR hi = MAX ( MAX ( MAX ( fact_orders[Order Date] ), MAX ( fact_marketing[Campaign Date] ) ), MAX ( fact_inventory[Month Start] ) ) VAR firstMonth = DATE ( YEAR ( MIN ( fact_orders[Order Date] ) ), MONTH ( MIN ( fact_orders[Order Date] ) ), 1 ) VAR lastMonth = DATE ( YEAR ( MAX ( fact_orders[Order Date] ) ), MONTH ( MAX ( fact_orders[Order Date] ) ), 1 ) RETURN ADDCOLUMNS ( CALENDAR ( DATE ( YEAR ( lo ), MONTH ( lo ), 1 ), EOMONTH ( hi, 0 ) ), "Year", YEAR ( [Date] ), "Quarter", "Q" & QUARTER ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM", "en-US" ), "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ), "Year Month", FORMAT ( [Date], "MMM yy", "en-US" ), "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ), "Weekday No", WEEKDAY ( [Date], 2 ), "Weekday", FORMAT ( [Date], "ddd", "en-US" ), "Is Full Month", NOT ( DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ) = firstMonth || DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ) = lastMonth ) )

