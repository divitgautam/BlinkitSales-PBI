/// One row per order (5,000): order header, its single item line, delivery and customer feedback merged 1:1. Revenue = Order Total. Source: data/clean/fact_orders.csv.
table fact_orders
	lineageTag: 8584bb35-ed47-4336-9470-63244b82bb6d

	/// Order identifier (unique).
	column 'Order Id'
		dataType: int64
		formatString: 0
		lineageTag: abbac70d-4331-4af1-a3be-052b1e7ce5c3
		summarizeBy: none
		sourceColumn: Order Id

		annotation SummarizationSetBy = User

	/// Foreign key to dim_customer.
	column 'Customer Id'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 99de261f-98d0-482b-8e62-908ecdb07859
		summarizeBy: none
		sourceColumn: Customer Id

		annotation SummarizationSetBy = User

	/// Foreign key to dim_product (one item per order).
	column 'Product Id'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f9bd4007-6e4a-497e-b4ff-e7481c59c4e7
		summarizeBy: none
		sourceColumn: Product Id

		annotation SummarizationSetBy = User

	/// Order date. Foreign key to the Date table.
	column 'Order Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		isHidden
		lineageTag: a5afeee0-4152-4940-a2c4-eca8f36da0e3
		summarizeBy: none
		sourceColumn: Order Date

		annotation SummarizationSetBy = User

	/// Hour of day the order was placed, 0-23.
	column 'Order Hour'
		dataType: int64
		formatString: 0
		lineageTag: 740e13a6-ae8f-4946-a323-d0f6c7080605
		summarizeBy: none
		sourceColumn: Order Hour

		annotation SummarizationSetBy = User

	/// Order header total in assumed INR. Source of Revenue.
	column 'Order Total'
		dataType: decimal
		formatString: ₹#,##0.00
		isHidden
		isAvailableInMdx: false
		lineageTag: e8e35ddd-27ae-4bff-80c4-dd7959b2933e
		summarizeBy: none
		sourceColumn: Order Total

		annotation SummarizationSetBy = User

	/// Quantity x unit price. Source of Line Value; does not reconcile to Order Total.
	column 'Line Amount'
		dataType: decimal
		formatString: ₹#,##0.00
		isHidden
		isAvailableInMdx: false
		lineageTag: 4e544846-c069-4aa2-8b97-999f49896502
		summarizeBy: none
		sourceColumn: Line Amount

		annotation SummarizationSetBy = User

	/// Units on the item line, 1-3.
	column Quantity
		dataType: int64
		formatString: 0
		isHidden
		isAvailableInMdx: false
		lineageTag: 43b3875f-5d31-4147-a33f-0422aa4949d9
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = User

	/// Item unit price in assumed INR.
	column 'Unit Price'
		dataType: decimal
		formatString: ₹#,##0.00
		lineageTag: fcec9cb5-0c29-467a-aff6-6c48c411c9f3
		summarizeBy: none
		sourceColumn: Unit Price

		annotation SummarizationSetBy = User

	/// Card, Cash, UPI or Wallet.
	column 'Payment Method'
		dataType: string
		lineageTag: 6e3a88e0-9d5e-41e6-b9a1-b98cf448d019
		summarizeBy: none
		sourceColumn: Payment Method

		annotation SummarizationSetBy = User

	/// On Time (up to 5 minutes late), Slightly Delayed or Significantly Delayed.
	column 'Delivery Status'
		dataType: string
		sortByColumn: 'Delivery Status Order'
		lineageTag: 811cf41c-d3e8-4cf1-88a2-76ab11ead96e
		summarizeBy: none
		sourceColumn: Delivery Status

		annotation SummarizationSetBy = User

	/// Sort order for Delivery Status (from Power Query source, not DAX, to avoid a circular sort-by).
	column 'Delivery Status Order'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 98c4513b-c838-4da5-8b4a-466563de01eb
		summarizeBy: none
		sourceColumn: Delivery Status Order

		annotation SummarizationSetBy = User

	/// Actual minus promised delivery time in minutes; negative means early.
	column 'Minutes Late'
		dataType: int64
		formatString: 0
		lineageTag: ccd48a8c-1920-452b-a1e6-5d7eb1dca9f3
		summarizeBy: none
		sourceColumn: Minutes Late

		annotation SummarizationSetBy = User

	/// TRUE when the status is not On Time (more than 5 minutes late).
	column 'Is Late'
		dataType: boolean
		lineageTag: 62c98fdc-02c4-47ef-9854-3ff749b2781d
		summarizeBy: none
		sourceColumn: Is Late

		annotation SummarizationSetBy = User

	/// Delivery distance in kilometres.
	column 'Distance Km'
		dataType: decimal
		formatString: 0.00
		lineageTag: 8539b15f-1934-46e3-a003-a6557a9cc087
		summarizeBy: none
		sourceColumn: Distance Km

		annotation SummarizationSetBy = User

	/// Customer rating, 1 to 5 stars.
	column Rating
		dataType: int64
		formatString: 0
		lineageTag: f634b47d-7286-438a-a4aa-3b9dafa03c29
		summarizeBy: none
		sourceColumn: Rating

		annotation SummarizationSetBy = User

	/// Feedback sentiment: Positive, Neutral or Negative.
	column Sentiment
		dataType: string
		lineageTag: 3354ab2d-7f02-41a0-b24f-b5ff5c0a125e
		summarizeBy: none
		sourceColumn: Sentiment

		annotation SummarizationSetBy = User

	/// Delivery, Customer Service, Product Quality or App Experience.
	column 'Feedback Category'
		dataType: string
		lineageTag: 9a9d3459-dc5a-4a28-b68c-30b3ee1aca5d
		summarizeBy: none
		sourceColumn: Feedback Category

		annotation SummarizationSetBy = User

	/// TRUE when the order was late or rated 1-2 stars. Basis of Revenue at Risk.
	column 'Poor Experience'
		dataType: boolean
		lineageTag: 6e3641d2-5002-4e4c-bc4d-351dd5681f73
		summarizeBy: none
		sourceColumn: Poor Experience

		annotation SummarizationSetBy = User

	/// Minutes late in 5-minute bands (Early, 0 to 5, ... 26 to 30).
	column 'Minutes Late Band' = VAR m = fact_orders[Minutes Late] RETURN SWITCH ( TRUE (), m < 0, "Early", m <= 5, "0 to 5", m <= 10, "6 to 10", m <= 15, "11 to 15", m <= 20, "16 to 20", m <= 25, "21 to 25", "26 to 30" )
		dataType: string
		sortByColumn: 'Minutes Late Band Order'
		lineageTag: cffbe1ba-bfdf-49d4-9357-cff7c8f19f71
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Sort order for Minutes Late Band.
	column 'Minutes Late Band Order' = VAR m = fact_orders[Minutes Late] RETURN SWITCH ( TRUE (), m < 0, 1, m <= 5, 2, m <= 10, 3, m <= 15, 4, m <= 20, 5, m <= 25, 6, 7 )
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: d413cd33-4125-4f42-8fee-247b7116c84d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Why an order counts as a poor experience: late, rated 1-2 stars, both, or neither.
	column 'Experience Class' = SWITCH ( TRUE (), fact_orders[Is Late] && fact_orders[Rating] <= 2, "Late and low rating", fact_orders[Is Late], "Late only", fact_orders[Rating] <= 2, "Low rating only", "Good experience" )
		dataType: string
		sortByColumn: 'Experience Class Order'
		lineageTag: bd6650f8-f778-4b98-82ef-06e51cba83ac
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Sort order for Experience Class.
	column 'Experience Class Order' = SWITCH ( TRUE (), fact_orders[Is Late] && fact_orders[Rating] <= 2, 1, fact_orders[Is Late], 2, fact_orders[Rating] <= 2, 3, 4 )
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 7162ea81-3570-43c1-b325-95904d04da82
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\" & SourceFolder & "\fact_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"order_id", "customer_id", "product_id", "order_date", "order_hour", "order_total", "line_value", "quantity", "unit_price", "payment_method", "delivery_status", "delivery_status_order", "minutes_late", "is_late", "distance_km", "rating", "sentiment", "feedback_category", "poor_experience"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"order_id", Int64.Type}, {"customer_id", Int64.Type}, {"product_id", Int64.Type}, {"order_date", type date}, {"order_hour", Int64.Type}, {"order_total", Currency.Type}, {"line_value", Currency.Type}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"payment_method", type text}, {"delivery_status", type text}, {"delivery_status_order", Int64.Type}, {"minutes_late", Int64.Type}, {"is_late", type logical}, {"distance_km", Currency.Type}, {"rating", Int64.Type}, {"sentiment", type text}, {"feedback_category", type text}, {"poor_experience", type logical}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"order_id", "Order Id"}, {"customer_id", "Customer Id"}, {"product_id", "Product Id"}, {"order_date", "Order Date"}, {"order_hour", "Order Hour"}, {"order_total", "Order Total"}, {"line_value", "Line Amount"}, {"quantity", "Quantity"}, {"unit_price", "Unit Price"}, {"payment_method", "Payment Method"}, {"delivery_status", "Delivery Status"}, {"delivery_status_order", "Delivery Status Order"}, {"minutes_late", "Minutes Late"}, {"is_late", "Is Late"}, {"distance_km", "Distance Km"}, {"rating", "Rating"}, {"sentiment", "Sentiment"}, {"feedback_category", "Feedback Category"}, {"poor_experience", "Poor Experience"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["FIRST_LETTER_OF_OBJECTS_MUST_BE_CAPITALIZED"]}
