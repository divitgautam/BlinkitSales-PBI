/// Sized revenue levers (annual, basis: last 12 full months) with their assumptions. Disconnected by design. Source: data/clean/levers.csv written by _build/forecast.py.
table Levers
	lineageTag: 220b4d6e-e4fd-4740-a627-c85687eb022d

	/// Lever name.
	column Lever
		dataType: string
		lineageTag: aef2a956-8752-4959-a03d-ae789386c5e6
		summarizeBy: none
		sourceColumn: Lever

		annotation SummarizationSetBy = User

	/// Lever with its value type, for chart labels.
	column 'Lever Label'
		dataType: string
		lineageTag: d3bb44fc-1da9-457b-ba2e-bf0f12732483
		summarizeBy: none
		sourceColumn: Lever Label

		annotation SummarizationSetBy = User

	/// Exposure removed, attributed revenue gained or stock value saved: not additive across types.
	column 'Lever Type'
		dataType: string
		lineageTag: d42f7788-1585-4b21-908a-120aadcbffa2
		summarizeBy: none
		sourceColumn: Lever Type

		annotation SummarizationSetBy = User

	/// What is assumed and how the value was sized.
	column Assumption
		dataType: string
		lineageTag: 0bb4ea74-13a5-402e-b521-05f908c54065
		summarizeBy: none
		sourceColumn: Assumption

		annotation SummarizationSetBy = User

	/// Annual value in assumed INR. Source of Lever Value.
	column 'Annual Value'
		dataType: decimal
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 49f79953-9284-4fad-b72d-6e371012d374
		summarizeBy: none
		sourceColumn: Annual Value

		annotation SummarizationSetBy = User

	/// Annual value as a share of the last 12 full months of revenue.
	column 'Pct of Revenue'
		dataType: decimal
		isHidden
		formatString: 0.0%
		isAvailableInMdx: false
		lineageTag: 6af95ca1-f10c-4853-993d-f39903ce14ad
		summarizeBy: none
		sourceColumn: Pct of Revenue

		annotation SummarizationSetBy = User

	/// How far to trust the sizing.
	column Confidence
		dataType: string
		lineageTag: 97bbc199-6681-41fb-abeb-9849215196c9
		summarizeBy: none
		sourceColumn: Confidence

		annotation SummarizationSetBy = User

	/// Period the lever was sized on.
	column Basis
		dataType: string
		lineageTag: 697c0b8a-80d9-4a07-b556-652ddcad3b5f
		summarizeBy: none
		sourceColumn: Basis

		annotation SummarizationSetBy = User

	partition Levers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\" & SourceFolder & "\Levers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"lever", "lever_label", "lever_type", "assumption", "annual_value", "pct_of_revenue", "confidence", "basis"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"lever", type text}, {"lever_label", type text}, {"lever_type", type text}, {"assumption", type text}, {"annual_value", Currency.Type}, {"pct_of_revenue", Currency.Type}, {"confidence", type text}, {"basis", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"lever", "Lever"}, {"lever_label", "Lever Label"}, {"lever_type", "Lever Type"}, {"assumption", "Assumption"}, {"annual_value", "Annual Value"}, {"pct_of_revenue", "Pct of Revenue"}, {"confidence", "Confidence"}, {"basis", "Basis"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["ENSURE_TABLES_HAVE_RELATIONSHIPS"]}

