/// Monthly revenue on full months (Apr 2023 to Oct 2024, Actual) and the forecast to Dec 2025 with an 80% band. Disconnected from Date by design. Source: data/clean/forecast.csv written by _build/forecast.py.
table Forecast
	lineageTag: 92e09b45-d332-4c30-a040-ec4c06da9a3e

	/// First day of the month.
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: baf60b80-1e92-4aa0-8918-ddbdd85ed699
		summarizeBy: none
		sourceColumn: Month Start

		annotation SummarizationSetBy = User

	/// Actual or Forecast row.
	column Kind
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 6ba6639a-65cc-4eef-a3c7-2f4bc694b2c3
		summarizeBy: none
		sourceColumn: Kind

		annotation SummarizationSetBy = User

	/// Actual monthly revenue (full months only).
	column Actual
		dataType: decimal
		formatString: #,##0
		isHidden
		isAvailableInMdx: false
		lineageTag: 75a49071-e110-44bf-8586-0091a148b81d
		summarizeBy: none
		sourceColumn: Actual

		annotation SummarizationSetBy = User

	/// Forecast monthly revenue; the last actual month repeats here so the lines join.
	column Forecast
		dataType: decimal
		formatString: #,##0
		isHidden
		isAvailableInMdx: false
		lineageTag: 4705293d-102f-4858-a077-13a90c4b152a
		summarizeBy: none
		sourceColumn: Forecast

		annotation SummarizationSetBy = User

	/// Lower end of the 80% band.
	column 'Low 80'
		dataType: decimal
		formatString: #,##0
		isHidden
		isAvailableInMdx: false
		lineageTag: aaf78976-c531-4d11-a384-79d0860ae56b
		summarizeBy: none
		sourceColumn: Low 80

		annotation SummarizationSetBy = User

	/// Upper end of the 80% band.
	column 'High 80'
		dataType: decimal
		formatString: #,##0
		isHidden
		isAvailableInMdx: false
		lineageTag: 0d65a334-489e-4d0b-b194-776a63efe296
		summarizeBy: none
		sourceColumn: High 80

		annotation SummarizationSetBy = User

	/// Month label, e.g. Nov 24.
	column 'Month Label' = FORMAT ( Forecast[Month Start], "MMM yy", "en-US" )
		dataType: string
		sortByColumn: 'Month Start'
		lineageTag: dca06105-2d43-4164-b726-66cae0da50d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Calendar year of the month (used to total 2025).
	column Year = YEAR ( Forecast[Month Start] )
		dataType: int64
		formatString: 0
		isHidden
		isAvailableInMdx: false
		lineageTag: b70e6fff-7bb0-4efd-80ad-ca1dd94d97ae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\" & SourceFolder & "\Forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"month_start", "kind", "actual", "forecast", "low80", "high80"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"month_start", type date}, {"kind", type text}, {"actual", Currency.Type}, {"forecast", Currency.Type}, {"low80", Currency.Type}, {"high80", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"month_start", "Month Start"}, {"kind", "Kind"}, {"actual", "Actual"}, {"forecast", "Forecast"}, {"low80", "Low 80"}, {"high80", "High 80"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["ENSURE_TABLES_HAVE_RELATIONSHIPS"]}
