/// Stock received and damaged per product and month (5,571 rows, from the monthly inventoryNew file). Source: data/clean/fact_inventory.csv.
table fact_inventory
	lineageTag: 9e9b6a65-5aed-4c9e-98de-1642c5ff1221

	/// Foreign key to dim_product.
	column 'Product Id'
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 0f5c8ee5-751c-4474-9538-88223c0a255e
		summarizeBy: none
		sourceColumn: Product Id

		annotation SummarizationSetBy = User

	/// First day of the month. Foreign key to the Date table.
	column 'Month Start'
		dataType: dateTime
		isHidden
		formatString: mmm yyyy
		isAvailableInMdx: false
		lineageTag: 1fbc3e66-59a8-4e55-9e99-00f719012158
		summarizeBy: none
		sourceColumn: Month Start

		annotation SummarizationSetBy = User

	/// Units received. Source of Stock Received.
	column 'Units Received'
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: 8a75ca0d-775d-45b1-ba35-de562da9334f
		summarizeBy: none
		sourceColumn: Units Received

		annotation SummarizationSetBy = User

	/// Units damaged. Source of Damaged Stock.
	column 'Units Damaged'
		dataType: int64
		isHidden
		formatString: #,##0
		isAvailableInMdx: false
		lineageTag: a965e2ea-864b-4184-aec2-56565b49e01b
		summarizeBy: none
		sourceColumn: Units Damaged

		annotation SummarizationSetBy = User

	partition fact_inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\" & SourceFolder & "\fact_inventory.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"product_id", "month_start", "stock_received", "damaged_stock"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"product_id", Int64.Type}, {"month_start", type date}, {"stock_received", Int64.Type}, {"damaged_stock", Int64.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"product_id", "Product Id"}, {"month_start", "Month Start"}, {"stock_received", "Units Received"}, {"damaged_stock", "Units Damaged"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["FIRST_LETTER_OF_OBJECTS_MUST_BE_CAPITALIZED"]}

