/// One row per customer in the customer file (2,500; 2,172 have orders). Name, email, phone and address are not loaded. Lifetime figures come from the orders table. Source: data/clean/dim_customer.csv.
table dim_customer
	lineageTag: 3cc1a486-b855-4355-86a9-f3589c7ea230

	/// Customer key.
	column 'Customer Id'
		dataType: int64
		formatString: 0
		isKey
		isHidden
		lineageTag: 7857e31c-89d6-4a8e-aea7-fb2b65b190b0
		summarizeBy: none
		sourceColumn: Customer Id

		annotation SummarizationSetBy = User

	/// Customer area.
	column Area
		dataType: string
		lineageTag: c317f1ec-fe02-40d1-97b9-730f8fd46aba
		summarizeBy: none
		sourceColumn: Area

		annotation SummarizationSetBy = User

	/// Postal code.
	column Pincode
		dataType: string
		dataCategory: PostalCode
		lineageTag: d5f1cae2-a33c-4868-a073-80a19bc42268
		summarizeBy: none
		sourceColumn: Pincode

		annotation SummarizationSetBy = User

	/// Stored registration date (unreliable: many orders precede it).
	column 'Registration Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: c2365f63-8d9c-498d-a695-e7e2e7d687af
		summarizeBy: none
		sourceColumn: Registration Date

		annotation SummarizationSetBy = User

	/// Stored segment: Regular, Premium, New or Inactive.
	column Segment
		dataType: string
		lineageTag: 01b23f44-818f-4e68-890f-109779dd3900
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = User

	/// Date of the customer's first order; blank without orders.
	column 'First Order Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		lineageTag: 9660d08d-807e-4ddd-8640-e1f810f59551
		summarizeBy: none
		sourceColumn: First Order Date

		annotation SummarizationSetBy = User

	/// Orders placed over the whole period (not affected by slicers).
	column 'Lifetime Orders'
		dataType: int64
		formatString: 0
		lineageTag: 7ee9aae4-ee3f-40c7-989e-046799b34d73
		summarizeBy: none
		sourceColumn: Lifetime Orders

		annotation SummarizationSetBy = User

	/// Order Total summed over the whole period (not affected by slicers).
	column 'Lifetime Revenue'
		dataType: decimal
		formatString: ₹#,##0.00
		lineageTag: 02757ef3-74e3-45c7-b0e0-9176e21fcc9f
		summarizeBy: none
		sourceColumn: Lifetime Revenue

		annotation SummarizationSetBy = User

	/// New (1 order), Repeat (2+ orders) or No orders.
	column 'Customer Type'
		dataType: string
		lineageTag: 37d9b0a6-9e03-45b6-ba82-796c4f136d72
		summarizeBy: none
		sourceColumn: Customer Type

		annotation SummarizationSetBy = User

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\" & SourceFolder & "\dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"customer_id", "area", "pincode", "registration_date", "segment", "first_order_date", "orders", "revenue", "customer_type"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"customer_id", Int64.Type}, {"area", type text}, {"pincode", type text}, {"registration_date", type date}, {"segment", type text}, {"first_order_date", type date}, {"orders", Int64.Type}, {"revenue", Currency.Type}, {"customer_type", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"customer_id", "Customer Id"}, {"area", "Area"}, {"pincode", "Pincode"}, {"registration_date", "Registration Date"}, {"segment", "Segment"}, {"first_order_date", "First Order Date"}, {"orders", "Lifetime Orders"}, {"revenue", "Lifetime Revenue"}, {"customer_type", "Customer Type"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs": ["FIRST_LETTER_OF_OBJECTS_MUST_BE_CAPITALIZED"]}
